---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PreviousNextNavigation from '../../components/PreviousNextNavigation.astro';
import { getNavigation, flattenNavigation } from '../../data/navigation';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  getNavigation(entries); // Fail compilation when content and navigation diverge.
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props;
const navigation = getNavigation(await getCollection('docs'));
const ordered = flattenNavigation(navigation);
const index = ordered.findIndex((node) => node.id === entry.id);
const node = ordered[index];
const parent = navigation.find((item) => item.children?.some((child) => child.id === entry.id));
const { Content } = await render(entry);
const description = entry.body?.trim().split('\n\n')[0] ?? entry.data.title;
---
<DocumentationLayout title={entry.data.title} description={description} navigation={navigation} currentId={entry.id}>
  <Breadcrumbs title={entry.data.title} parent={parent} />
  <article class="documentation-article">
    <h1>{entry.data.title}</h1>
    <div class="article-rule" aria-hidden="true"></div>
    <div class="prose"><Content /></div>
    {entry.data.example && <aside class="example"><h2>Ejemplo</h2><p>{entry.data.example}</p></aside>}
    {node.children && <section class="related"><h2>En este apartado</h2><ul>{node.children.map((child) => <li><a href={child.path}><span>{child.title}</span><span aria-hidden="true">→</span></a></li>)}</ul></section>}
  </article>
  <PreviousNextNavigation previous={ordered[index - 1]} next={ordered[index + 1]} />
</DocumentationLayout>
